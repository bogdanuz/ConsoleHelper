{
  "manifest_version": 3,
  "name": "ConsoleHelper",
  "version": "0.2.2",
  "description": "Alt+Shift+H opens ConsoleHelper menu on the current tab",
  "permissions": ["activeTab", "scripting"],
  "commands": {
    "open-menu": {
      "suggested_key": {
        "default": "Alt+Shift+H",
        "mac": "Alt+Shift+H"
      },
      "description": "Open ConsoleHelper menu"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "ConsoleHelper menu (Alt+Shift+H)"
  }
}
