# Local concept notes / screenshots — keep on disk, never push
concept/

# Dependencies (reinstall with npm install)
node_modules/

# Build output (recreate with npm run build)
dist/

# Env & secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key
secrets/
credentials*.json

# Logs & debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test / coverage
coverage/
.nyc_output/

# Bundler / tooling caches
.vite/
.cache/
.turbo/
*.tsbuildinfo

# OS junk
.DS_Store
Thumbs.db
Desktop.ini

# Editors (keep project .cursor/rules & skills tracked)
.idea/
*.swp
*.swo

# Local-only overrides
*.local
*.local.*
.vscode/settings.json

# Optional Playwright / e2e artifacts if added later
test-results/
playwright-report/
blob-report/
