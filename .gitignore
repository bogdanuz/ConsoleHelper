# Local concept notes / screenshots — keep on disk, never push
concept/

# Quarantine instead of delete — local only, never on GitHub
fordelete/

# Dependencies (reinstall with npm install)
node_modules/

# Build output (recreate with npm run build)
dist/

# Env & secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key
secrets/
credentials*.json

# Logs & debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.cursor/debug*.log
.cursor/debug-*.log
.cursor/**/debug*.log

# Test / coverage / e2e artifacts
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Bundler / tooling caches
.vite/
.cache/
.turbo/
*.tsbuildinfo

# OS junk
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# Editors (keep project .cursor/rules & skills tracked)
.idea/
*.swp
*.swo
*~

# Local-only overrides
*.local
*.local.*
.vscode/settings.json
.vscode/*.local.json

# Optional scratch / temp
tmp/
temp/
*.tmp
*.bak
*.orig
